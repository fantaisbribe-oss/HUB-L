rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Profiles: users can read profiles and write their own
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() || request.resource.data.email != null;
    }

    // Courses: readable by all signed-in users, writable by lecturer owner
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // Enrollments: students can register, lecturers of the course can update attendance/marks
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Assignments: read by enrolled students and lecturers, created by lecturers
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Submissions: submitted by student, graded by lecturer
    match /submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    // Quizzes & exams: created by lecturer, taken by enrolled students
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    // Quiz attempts
    match /quizAttempts/{attemptId} {
      allow read: if true;
      allow write: if true;
    }

    // Course announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Live video meetings
    match /meetings/{meetingId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
