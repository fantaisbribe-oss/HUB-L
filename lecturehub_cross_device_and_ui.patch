+async function tryIceRestart(peerId) {
+  const peer = CALL.peers[peerId];
+  if (!peer || !peer.pc || !CALL.isHost) return;
+  try {
+    const offer = await peer.pc.createOffer({ iceRestart: true });
+    await peer.pc.setLocalDescription(offer);
+    if (window.lhSignaling) {
+      window.lhSignaling.sendCallSignal(CALL.room, {
+        from: CALL.me,
+        fromName: db.user.name,
+        to: peerId,
+        type: 'offer',
+        payload: { sdp: offer.sdp, type: offer.type },
+        timestamp: Date.now()
+      });
+    }
+  } catch (e) {
+    console.warn('ICE restart error:', e);
+  }
+}
