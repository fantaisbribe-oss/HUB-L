+function endCall() {
+  if (!CALL.room && !CALL.stream) return;
+
+  if (window.lhSignaling && CALL.room) {
+    window.lhSignaling.leaveCallRoom(CALL.room, CALL.me, CALL.isHost);
+  }
+
+  if (CALL.unsubSignals) {
+    try { CALL.unsubSignals(); } catch (e) {}
+    CALL.unsubSignals = null;
+  }
+
+  Object.keys(CALL.peers).forEach(dropPeer);
+
+  if (CALL.stream) {
+    CALL.stream.getTracks().forEach(t => t.stop());
+  }
+  if (CALL.screen) {
+    CALL.screen.getTracks().forEach(t => t.stop());
+  }
+
+  clearInterval(CALL.timer);
+  Object.assign(CALL, {
+    room: null,
+    stream: null,
+    screen: null,
+    sharing: false,
+    status: 'idle',
+    peers: {}
+  });
+  localStream = null;
+}
