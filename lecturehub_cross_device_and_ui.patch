+async function startCall(codeIn, asHost) {
+  const code = normCode(codeIn);
+  if (code.length < 4) {
+    toast('Please enter the 6-character access code.');
+    return;
+  }
+  if (CALL.room) return;
+
+  if (!navigator.mediaDevices || !window.RTCPeerConnection) {
+    toast('This browser does not support WebRTC video calls. Please use HTTPS on mobile Chrome or Safari.');
+    return;
+  }
+
+  // Access control: verify student enrollment if course-restricted
+  const meetingRecord = (db.meetings || []).find(m => m.accessCode === code);
+  if (!asHost && meetingRecord && meetingRecord.courseCode) {
+    const course = courseByCode(meetingRecord.courseCode);
+    if (course && typeof studentEnrollments === 'function') {
+      const isEnrolled = studentEnrollments(db.user.id).some(e => String(e.courseId) === String(course.id));
+      if (!isEnrolled) {
+        toast(`This call is restricted to students registered in ${course.code}.`);
+        return;
+      }
+    }
+  }
+
+  toast(asHost ? 'Starting session & opening cloud room…' : 'Connecting to live class…');
+
+  const title = asHost
+    ? (meetingRecord ? meetingRecord.title : 'Live Classroom')
+    : (meetingRecord ? meetingRecord.title : 'Live Classroom');
+
+  Object.assign(CALL, {
+    room: code,
+    roomTitle: title,
+    courseCode: meetingRecord ? meetingRecord.courseCode : '',
+    me: (asHost ? 'host_' : 'stu_') + db.user.id + '_' + Math.random().toString(36).slice(2, 7),
+    isHost: !!asHost,
+    peers: {},
+    chat: [],
+    mic: true,
+    cam: true,
+    hand: false,
+    sharing: false,
+    facingMode: 'user',
+    status: 'starting',
+    stream: null
+  });
+
+  const abort = msg => {
+    endCall();
+    toast(msg);
+  };
+
+  // Request camera & microphone
+  try {
+    CALL.stream = await navigator.mediaDevices.getUserMedia({
+      video: { facingMode: CALL.facingMode, width: { ideal: 1280 }, height: { ideal: 720 } },
+      audio: { echoCancellation: true, noiseSuppression: true }
+    });
+  } catch (err) {
+    console.warn('Video+Audio getUserMedia failed:', err);
+    try {
+      CALL.stream = await navigator.mediaDevices.getUserMedia({ audio: true });
+      CALL.cam = false;
+      toast('Camera unavailable: joined with audio only');
+    } catch (err2) {
+      console.error('Audio getUserMedia failed:', err2);
+      return abort('Allow camera & microphone access in your browser settings to join the call.');
+    }
+  }
+
+  localStream = CALL.stream;
+  CALL.t0 = Date.now();
+  CALL.timer = setInterval(() => {
+    const el = document.getElementById('callTimer');
+    if (el) {
+      const s = Math.floor((Date.now() - CALL.t0) / 1000);
+      el.textContent = String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
+    }
+  }, 1000);
+
+  // Setup Firestore signaling
+  if (window.lhSignaling) {
+    if (asHost) {
+      await window.lhSignaling.initCallRoom(code, {
+        hostId: db.user.id,
+        hostName: db.user.name,
+        title: CALL.roomTitle,
+        courseCode: CALL.courseCode,
+        active: true
+      });
+    }
+
+    // Subscribe to incoming signals
+    CALL.unsubSignals = window.lhSignaling.listenCallSignals(code, CALL.me, onIncomingSignal);
+
+    // If student, announce arrival to host
+    if (!asHost) {
+      window.lhSignaling.sendCallSignal(code, {
+        from: CALL.me,
+        fromName: db.user.name,
+        to: 'host',
+        type: 'join',
+        payload: {},
+        timestamp: Date.now()
+      });
+    }
+  } else {
+    console.warn('[LectureHub] Firestore signaling initializing, fallback to broadcast');
+  }
+
+  renderMeetingTab(document.getElementById('appContent'));
+}
