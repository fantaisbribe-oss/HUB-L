+/* ===== LectureHub Design System: Modern Premium EdTech ===== */
+:root {
+  --navy: #0f172a;
+  --navy-light: #1e293b;
+  --blue: #2563eb;
+  --blue-hover: #1d4ed8;
+  --blue-dark: #1e40af;
+  --sky: #eff6ff;
+  --sky-border: #dbeafe;
+  --sky-text: #1d4ed8;
+  --ink: #0f172a;
+  --muted: #64748b;
+  --line: #e2e8f0;
+  --bg: #f8fafc;
+  --card: #ffffff;
+  --green: #059669;
+  --green-bg: #ecfdf5;
+  --orange: #d97706;
+  --orange-bg: #fffbeb;
+  --red: #dc2626;
+  --red-bg: #fef2f2;
+  --shadow-sm: 0 1px 2px 0 rgba(15, 23, 42, 0.05);
+  --shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.08), 0 1px 2px -1px rgba(15, 23, 42, 0.08);
+  --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 2px 4px -2px rgba(15, 23, 42, 0.06);
+  --shadow-lg: 0 10px 15px -3px rgba(15, 23, 42, 0.08), 0 4px 6px -4px rgba(15, 23, 42, 0.04);
+  --display: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
+}
+:root[data-theme=dark] {
+  --navy: #090d16;
+  --navy-light: #111827;
+  --ink: #f8fafc;
+  --muted: #94a3b8;
+  --line: #1e293b;
+  --bg: #0b0f19;
+  --card: #111827;
+  --sky: #1e293b;
+  --sky-border: #334155;
+  --sky-text: #60a5fa;
+}
+* { scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent; }
+body { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; font-size: 14.5px; line-height: 1.55; color: var(--ink); background: var(--bg); -webkit-font-smoothing: antialiased; }
+h1, h2, h3, h4 { font-family: var(--display); letter-spacing: -0.025em; font-weight: 700; color: var(--ink); }
+:focus-visible { outline: 2.5px solid var(--blue); outline-offset: 2px; }
+button { transition: background-color 0.15s ease, transform 0.08s ease, box-shadow 0.15s ease, border-color 0.15s ease; }
+button:active { transform: scale(0.98); }
+.primary { background: var(--blue); color: #fff; box-shadow: 0 1px 2px rgba(37,99,235,0.2); font-weight: 600; }
+.primary:hover { background: var(--blue-hover); box-shadow: 0 4px 12px -2px rgba(37,99,235,0.35); }
+.soft { background: var(--sky); color: var(--sky-text); font-weight: 600; border: 1px solid var(--sky-border); }
+.soft:hover { background: #dbeafe; }
+.outline { background: var(--card); border: 1px solid var(--line); color: var(--ink); font-weight: 600; }
+.outline:hover { background: #f1f5f9; border-color: #cbd5e1; }
+.danger { background: var(--red-bg); color: var(--red); font-weight: 600; border: 1px solid #fecaca; }
+.danger:hover { background: #fee2e2; }
+
 /* sidebar */
