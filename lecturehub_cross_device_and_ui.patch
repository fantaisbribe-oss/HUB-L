+async function addOrQueueCandidate(peerId, candidateData) {
+  const peer = CALL.peers[peerId];
+  if (!peer) return;
+  const candidate = new RTCIceCandidate(candidateData);
+  if (peer.pc.remoteDescription && peer.pc.remoteDescription.type) {
+    try {
+      await peer.pc.addIceCandidate(candidate);
+    } catch (e) {
+      console.warn('addIceCandidate error:', e);
+    }
+  } else {
+    peer.iceQueue.push(candidate);
+  }
+}
+
+async function flushIceQueue(peerId) {
+  const peer = CALL.peers[peerId];
+  if (!peer || !peer.iceQueue.length) return;
+  const queue = [...peer.iceQueue];
+  peer.iceQueue = [];
+  for (const cand of queue) {
+    try {
+      await peer.pc.addIceCandidate(cand);
+    } catch (e) {
+      console.warn('flush candidate error:', e);
+    }
+  }
+}
