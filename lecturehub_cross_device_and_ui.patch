+async function onIncomingSignal(sig, sigId) {
+  if (!CALL.room || !CALL.stream || !sig) return;
+  if (sig.from === CALL.me) return;
+  // If target specified, must match me or 'all' or 'host'
+  if (sig.to && sig.to !== CALL.me && sig.to !== 'all' && !(sig.to === 'host' && CALL.isHost)) {
+    return;
+  }
+
+  const senderId = sig.from;
+  const senderName = sig.fromName || 'Participant';
+
+  if (sig.type === 'join') {
+    // When student joins, host initiates WebRTC offer
+    if (CALL.isHost) {
+      const peer = createPeerConnection(senderId, senderName, true);
+      try {
+        const offer = await peer.pc.createOffer({ offerToReceiveAudio: true, offerToReceiveVideo: true });
+        await peer.pc.setLocalDescription(offer);
+        if (window.lhSignaling) {
+          window.lhSignaling.sendCallSignal(CALL.room, {
+            from: CALL.me,
+            fromName: db.user.name,
+            to: senderId,
+            type: 'offer',
+            payload: { sdp: offer.sdp, type: offer.type },
+            timestamp: Date.now()
+          });
+        }
+        drawTiles();
+        drawStatusBadge();
+      } catch (err) {
+        console.error('Error creating offer:', err);
+      }
+    }
+  } else if (sig.type === 'offer') {
+    // Student receives offer from host
+    const peer = createPeerConnection(senderId, senderName, false);
+    try {
+      await peer.pc.setRemoteDescription(new RTCSessionDescription(sig.payload));
+      await flushIceQueue(senderId);
+      const answer = await peer.pc.createAnswer();
+      await peer.pc.setLocalDescription(answer);
+      if (window.lhSignaling) {
+        window.lhSignaling.sendCallSignal(CALL.room, {
+          from: CALL.me,
+          fromName: db.user.name,
+          to: senderId,
+          type: 'answer',
+          payload: { sdp: answer.sdp, type: answer.type },
+          timestamp: Date.now()
+        });
+      }
+      drawTiles();
+      drawStatusBadge();
+    } catch (err) {
+      console.error('Error handling offer:', err);
+    }
+  } else if (sig.type === 'answer') {
+    const peer = CALL.peers[senderId];
+    if (peer && peer.pc.signalingState === 'have-local-offer') {
+      try {
+        await peer.pc.setRemoteDescription(new RTCSessionDescription(sig.payload));
+        await flushIceQueue(senderId);
+        drawTiles();
+        drawStatusBadge();
+      } catch (err) {
+        console.error('Error handling answer:', err);
+      }
+    }
+  } else if (sig.type === 'candidate') {
+    await addOrQueueCandidate(senderId, sig.payload);
+  } else if (sig.type === 'state') {
+    const peer = CALL.peers[senderId];
+    if (peer) {
+      Object.assign(peer, {
+        mic: sig.payload.mic !== false,
+        cam: sig.payload.cam !== false,
+        hand: !!sig.payload.hand
+      });
+      drawTiles();
+    }
+  } else if (sig.type === 'chat') {
+    CALL.chat.push({ n: senderName, x: sig.payload.x });
+    drawChat();
+  } else if (sig.type === 'bye') {
+    dropPeer(senderId);
+    toast(`${senderName} left the session`);
+  }
+}
