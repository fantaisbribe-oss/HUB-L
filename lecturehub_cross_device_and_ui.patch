-.logo{background:var(--gold);color:#2b1d00;border-radius:12px;font-family:var(--display);font-weight:800}
-.brand strong{font-family:var(--display);font-size:18px;letter-spacing:-.02em}.brand small{color:#8fb3b4}
-.navlabel{text-transform:lowercase;letter-spacing:0;font-size:12px;font-weight:600;color:#8fb3b4}.navlabel::first-letter{text-transform:uppercase}
-.nav button{border-radius:10px;color:#c5dcdc;position:relative;min-height:44px}
-.nav button.active,.nav button:hover{background:rgba(255,255,255,.09);color:#fff}
-.nav button.active{background:rgba(255,255,255,.13);font-weight:700}
-.nav button.active::before{content:"";position:absolute;left:-14px;top:11px;bottom:11px;width:4px;border-radius:0 4px 4px 0;background:var(--gold)}
-.sidebottom{border-top:1px solid rgba(255,255,255,.1);color:#8fb3b4}.sidebottom .dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#3ddc97;margin-right:8px}
