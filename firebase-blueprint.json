{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for student or lecturer",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric identifier" },
        "accountId": { "type": "string", "description": "Unique account identifier" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["student", "lecturer", "admin"], "description": "User role" },
        "indexNo": { "type": "string", "description": "Student index number" },
        "level": { "type": "string", "description": "Academic level e.g. Level 100" },
        "phone": { "type": "string", "description": "Phone number" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["name", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic course level section created by a lecturer",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Course identifier" },
        "ownerId": { "type": "number", "description": "Lecturer UID or numeric ID" },
        "name": { "type": "string", "description": "Course title" },
        "level": { "type": "string", "description": "Level e.g. Level 100" },
        "code": { "type": "string", "description": "Unique registration code" },
        "semester": { "type": "string", "description": "Semester title" },
        "days": { "type": "array", "description": "Scheduled days of week" },
        "startDate": { "type": "string", "description": "Start date YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "End date YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Start time HH:mm" },
        "endTime": { "type": "string", "description": "End time HH:mm" },
        "location": { "type": "string", "description": "Classroom or hall" },
        "attendanceMark": { "type": "number", "description": "Mark per session present" },
        "quizWeight": { "type": "number", "description": "Quiz weighting percentage in CA" },
        "attendanceWeight": { "type": "number", "description": "Attendance weighting percentage in CA" },
        "assignmentWeight": { "type": "number", "description": "Assignment weighting percentage in CA" },
        "examMax": { "type": "number", "description": "Exam total marks" },
        "caShare": { "type": "number", "description": "CA share percentage of total marks" }
      },
      "required": ["name", "level", "code"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student enrollment record for a specific course",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Enrollment ID" },
        "courseId": { "type": "number", "description": "Enrolled course ID" },
        "courseCode": { "type": "string", "description": "Course code" },
        "courseName": { "type": "string", "description": "Course title" },
        "studentId": { "type": "number", "description": "Student user ID" },
        "accountId": { "type": "string", "description": "Student account ID" },
        "fullName": { "type": "string", "description": "Student full name" },
        "indexNo": { "type": "string", "description": "Student index number" },
        "phone": { "type": "string", "description": "Phone number" },
        "level": { "type": "string", "description": "Academic level" },
        "attendance": { "type": "object", "description": "Date-indexed attendance mapping" },
        "marks": { "type": "object", "description": "Marks record including exam_main" },
        "registeredAt": { "type": "string", "description": "Registration date" }
      },
      "required": ["courseId", "studentId", "courseCode"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Course assignment published by lecturer",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Assignment ID" },
        "ownerId": { "type": "number", "description": "Lecturer user ID" },
        "courseCode": { "type": "string", "description": "Course code" },
        "type": { "type": "string", "description": "Assignment type" },
        "title": { "type": "string", "description": "Assignment title" },
        "due": { "type": "string", "description": "Due date YYYY-MM-DD" },
        "desc": { "type": "string", "description": "Instructions" }
      },
      "required": ["title", "courseCode"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student assignment submission with mark and feedback",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Submission ID" },
        "assignmentId": { "type": "number", "description": "Assignment ID" },
        "studentId": { "type": "number", "description": "Student user ID" },
        "studentName": { "type": "string", "description": "Student full name" },
        "courseCode": { "type": "string", "description": "Course code" },
        "itemTitle": { "type": "string", "description": "Assignment title" },
        "fileName": { "type": "string", "description": "Submitted file name" },
        "fileType": { "type": "string", "description": "File extension or type" },
        "fileDataUrl": { "type": "string", "description": "Data URL or storage link" },
        "submissionDate": { "type": "string", "description": "Date submitted" },
        "status": { "type": "string", "description": "Submission status" },
        "mark": { "type": "string", "description": "Grade awarded" },
        "feedback": { "type": "string", "description": "Lecturer feedback" }
      },
      "required": ["assignmentId", "studentId", "courseCode"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Live quiz or examination",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Quiz ID" },
        "ownerId": { "type": "number", "description": "Lecturer ID" },
        "courseCode": { "type": "string", "description": "Course code" },
        "title": { "type": "string", "description": "Quiz title" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "startAt": { "type": "string", "description": "Start ISO datetime" },
        "endAt": { "type": "string", "description": "End ISO datetime" },
        "releaseResults": { "type": "boolean", "description": "Whether results are released to students" },
        "questions": { "type": "array", "description": "List of questions with marks" },
        "createdAt": { "type": "string", "description": "Created datetime" }
      },
      "required": ["title", "courseCode", "duration"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student quiz attempt and answers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Attempt ID" },
        "quizId": { "type": "number", "description": "Quiz ID" },
        "studentId": { "type": "number", "description": "Student user ID" },
        "courseCode": { "type": "string", "description": "Course code" },
        "answers": { "type": "object", "description": "Answers mapping" },
        "startedAt": { "type": "string", "description": "Start datetime" },
        "submittedAt": { "type": "string", "description": "Submission datetime" },
        "score": { "type": "number", "description": "Final score" },
        "objectiveScore": { "type": "number", "description": "Auto-graded score" },
        "manualScore": { "type": "number", "description": "Manual score" },
        "maxScore": { "type": "number", "description": "Total marks" },
        "needsManual": { "type": "boolean", "description": "Whether short answer grading is pending" }
      },
      "required": ["quizId", "studentId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Course announcement from lecturer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Announcement ID" },
        "type": { "type": "string", "description": "video, postponed, cancelled, venue, urgent, general" },
        "courseId": { "type": "number", "description": "Course ID" },
        "courseCode": { "type": "string", "description": "Course code" },
        "courseName": { "type": "string", "description": "Course title" },
        "level": { "type": "string", "description": "Academic level" },
        "title": { "type": "string", "description": "Headline" },
        "message": { "type": "string", "description": "Details" },
        "appliesDate": { "type": "string", "description": "Applies date" },
        "author": { "type": "string", "description": "Lecturer name" },
        "createdAt": { "type": "string", "description": "Created datetime" },
        "withdrawn": { "type": "boolean", "description": "Whether withdrawn by lecturer" }
      },
      "required": ["courseId", "title", "message"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Live video classroom session",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Meeting ID" },
        "ownerId": { "type": "number", "description": "Lecturer ID" },
        "courseCode": { "type": "string", "description": "Course code" },
        "title": { "type": "string", "description": "Session title" },
        "accessCode": { "type": "string", "description": "6-character access code" }
      },
      "required": ["title", "courseCode", "accessCode"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered student and lecturer profiles"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Lecturer courses and levels"
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Course enrollments connecting students to courses"
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Course assignments"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Student assignment submissions and marks"
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Course quizzes and exams"
    },
    "/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Student quiz attempts and grades"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Lecturer announcements for registered courses"
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Live video classroom sessions and access codes"
    }
  }
}
